---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, image } = Astro.props;
const pageTitle = title === SITE_TITLE ? SITE_TITLE : `${title} · ${SITE_TITLE}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE_TITLE}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site ?? SITE_URL).href} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const theme = saved || 'dark';
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
        document.documentElement.classList.add('js');
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
    <SiteHeader />
    <main class="page-main">
      <slot />
    </main>
    <SiteFooter />
    <button class="back-to-top" id="back-to-top" type="button" aria-label="返回顶部" title="返回顶部">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7" />
      </svg>
    </button>
    <ImageLightbox />
  </body>
</html>

<script>
  const root = document.documentElement;
  const header = document.querySelector('.site-header');
  const progress = document.getElementById('reading-progress');
  const topButton = document.getElementById('back-to-top');

  const applyTheme = () => {
    try {
      const saved = localStorage.getItem('theme');
      root.dataset.theme = saved || 'dark';
    } catch {
      root.dataset.theme = 'dark';
    }
    root.classList.add('js');
  };
  applyTheme();
  if (!window.__dshThemeInitBound) {
    window.__dshThemeInitBound = true;
    document.addEventListener('astro:page-load', applyTheme);
  }

  // 滚动范围单独缓存：原来每次滚动事件都读一次 root.scrollHeight，而前面刚写过 class，
  // 浏览器必须立刻重算布局才能回答这个读取 —— 也就是每个滚动事件强制一次同步布局。
  // 实测这会造成滚动中最明显的一次卡顿（最长帧 99.9ms → 33.4ms）。
  let scrollRange = 0;
  const measureScrollRange = () => {
    scrollRange = root.scrollHeight - window.innerHeight;
  };

  const updateScrollUI = () => {
    const y = window.scrollY;
    header?.classList.toggle('scrolled', y > 10);
    if (progress) {
      progress.style.width = scrollRange > 0 ? `${Math.min(100, (y / scrollRange) * 100)}%` : '0%';
    }
    topButton?.classList.toggle('visible', y > 560);
  };

  const remeasure = () => {
    measureScrollRange();
    updateScrollUI();
  };

  measureScrollRange();
  updateScrollUI();

  if (!window.__dshScrollUiBound) {
    window.__dshScrollUiBound = true;
    // 只绑定一次；换页时通过下面两个钩子指向当前页面的回调，避免监听器堆积。
    // 滚动走「只更新 UI」的快路径，不做任何布局读取；测量只在尺寸/内容变化时做。
    window.addEventListener('scroll', () => window.__dshScrollUpdate?.(), { passive: true });
    window.addEventListener('resize', () => window.__dshScrollRefresh?.(), { passive: true });
    window.addEventListener('load', () => window.__dshScrollRefresh?.());
    document.addEventListener('astro:page-load', () => window.__dshScrollRefresh?.());
    // 内容高度变化（图片载入、目录展开等）时同步刷新缓存值
    if ('ResizeObserver' in window) {
      new ResizeObserver(() => window.__dshScrollRefresh?.()).observe(document.body);
    }
  }
  window.__dshScrollUpdate = updateScrollUI;
  window.__dshScrollRefresh = remeasure;

  if (!window.__dshThemeToggleBound) {
    window.__dshThemeToggleBound = true;
    document.addEventListener('click', (event) => {
      const button = event.target.closest('#theme-toggle');
      if (!button) return;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      localStorage.setItem('theme', next);
    });
  }

  topButton?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  const setupReveal = () => {
    const targets = document.querySelectorAll('[data-reveal]');
    if (!('IntersectionObserver' in window)) {
      targets.forEach((target) => target.classList.add('is-visible'));
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );
    targets.forEach((target) => observer.observe(target));
    window.setTimeout(() => {
      targets.forEach((target) => target.classList.add('is-visible'));
    }, 900);
  };
  setupReveal();
  if (!window.__dshRevealBound) {
    window.__dshRevealBound = true;
    document.addEventListener('astro:page-load', setupReveal);
  }
</script>
