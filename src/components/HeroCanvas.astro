---
import { SITE_HERO_IMAGE } from '../consts';

interface Props {
  title: string;
}

const { title } = Astro.props;
const hasExtra = Astro.slots.has('default');
---

<section
  class="hero"
  id="hero"
  data-extra={hasExtra ? 'true' : 'false'}
  data-image={SITE_HERO_IMAGE ? 'true' : 'false'}
  aria-label="博客简介"
>
  {
    SITE_HERO_IMAGE ? (
      <div class="hero-image-frame">
        {/*
          decoding="async" 让 3840x2160 的解码离开主线程，避免首屏被解码卡住；
          fetchpriority="high" 因为它是 LCP 元素，要和渲染阻塞的 CSS/字体抢带宽。
          注意 canvas 分支只在没有 hero 图时才走，所以有图时没有动画在跑。
        */}
        <img
          class="hero-image"
          id="hero-image"
          src={SITE_HERO_IMAGE}
          alt=""
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <script is:inline>
        // 内联执行：立刻进入「加载中」状态，避免先全亮再变透明的闪烁。
        // JS 被禁用时这段不执行，图片保持默认可见——不会出现图片消失的故障。
        (() => {
          const image = document.getElementById('hero-image');
          if (!image) return;
          image.classList.add('is-loading');
          // 兜底：即使后面的模块脚本出错，也保证图片最终会显示
          window.setTimeout(() => {
            image.classList.remove('is-loading');
            image.classList.add('is-ready');
          }, 2500);
        })();
      </script>
    ) : (
      <canvas id="hero-canvas" aria-hidden="true"></canvas>
    )
  }
  <div class="hero-layout" id="hero-layout">
    <div class="hero-copy">
      <h1 class="hero-title">{'\u00A0' + title}</h1>
    </div>
    <slot />
  </div>
  <a class="hero-scroll" href="#posts" aria-label="向下浏览"></a>
</section>

<script>
  (() => {
    const hero = document.getElementById('hero');
    const layout = document.getElementById('hero-layout');
    if (!hero) return;

    // hero 图解码完成后再淡入：解码期间先显示主题色渐变，避免大图「砸」进首屏
    const heroImage = document.getElementById('hero-image');
    if (heroImage) {
      const reveal = () => {
        // 移除 is-loading 才会回到默认的 opacity:1，从而触发过渡
        heroImage.classList.remove('is-loading');
        heroImage.classList.add('is-ready');
      };
      const afterDecode = () => {
        if (typeof heroImage.decode === 'function') heroImage.decode().then(reveal, reveal);
        else reveal();
      };
      if (heroImage.complete && heroImage.naturalWidth > 0) afterDecode();
      else {
        heroImage.addEventListener('load', afterDecode, { once: true });
        heroImage.addEventListener('error', reveal, { once: true });
      }
    }

    const canvas = document.getElementById('hero-canvas');
    const ctx = canvas ? canvas.getContext('2d') : null;
    if (canvas && !ctx) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const palette = { accent: '#5aa7d8', accent2: '#b3123c' };
    let width = 0;
    let height = 0;
    let particles = [];
    let rafId = 0;
    const mouse = { x: -9999, y: -9999 };

    const readPalette = () => {
      const styles = getComputedStyle(document.documentElement);
      palette.accent = styles.getPropertyValue('--accent').trim() || palette.accent;
      palette.accent2 = styles.getPropertyValue('--accent-2').trim() || palette.accent2;
    };

    const toRgba = (hex, alpha) => {
      const cleaned = hex.replace('#', '');
      const full = cleaned.length === 3 ? cleaned.split('').map((c) => c + c).join('') : cleaned;
      const value = parseInt(full, 16);
      const r = (value >> 16) & 255;
      const g = (value >> 8) & 255;
      const b = value & 255;
      return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    };

    const spawn = () => {
      if (!ctx) return;
      const count = Math.min(110, Math.max(42, Math.floor(width / 12)));
      particles = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.32,
        vy: (Math.random() - 0.5) * 0.32,
        r: Math.random() * 1.7 + 0.8,
        warm: Math.random() > 0.78,
      }));
    };

    const resize = () => {
      const rect = hero.getBoundingClientRect();
      width = Math.max(1, rect.width);
      height = Math.max(1, rect.height);
      if (canvas && ctx) {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        spawn();
        if (reducedMotion) draw();
      }
    };

    const draw = () => {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      const linkDist = Math.min(130, width / 8);

      for (const p of particles) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = toRgba(p.warm ? palette.accent2 : palette.accent, 0.55);
        ctx.fill();
      }

      for (let i = 0; i < particles.length; i += 1) {
        const a = particles[i];
        for (let j = i + 1; j < particles.length; j += 1) {
          const b = particles[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const dist = Math.hypot(dx, dy);
          if (dist < linkDist) {
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.strokeStyle = toRgba(palette.accent, (1 - dist / linkDist) * 0.14);
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }
        const dm = Math.hypot(a.x - mouse.x, a.y - mouse.y);
        if (dm < 180) {
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(mouse.x, mouse.y);
          ctx.strokeStyle = toRgba(palette.accent2, (1 - dm / 180) * 0.26);
          ctx.lineWidth = 1;
          ctx.stroke();
        }
      }

      if (!reducedMotion) rafId = requestAnimationFrame(draw);
    };

    const start = () => {
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(draw);
    };

    const handlePointer = (event) => {
      const rect = hero.getBoundingClientRect();
      mouse.x = event.clientX - rect.left;
      mouse.y = event.clientY - rect.top;
      if (layout && !reducedMotion) {
        const cx = (event.clientX / window.innerWidth - 0.5) * 12;
        const cy = (event.clientY / window.innerHeight - 0.5) * 8;
        layout.style.transform = `translate(${cx.toFixed(1)}px, ${cy.toFixed(1)}px)`;
      }
    };

    const clearPointer = () => {
      mouse.x = -9999;
      mouse.y = -9999;
      if (layout) layout.style.transform = '';
    };

    readPalette();
    resize();
    window.addEventListener('resize', resize);
    hero.addEventListener('pointermove', handlePointer, { passive: true });
    hero.addEventListener('pointerleave', clearPointer);
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      window.setTimeout(readPalette, 0);
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(rafId);
      } else if (!reducedMotion) {
        start();
      }
    });
  })();
</script>
