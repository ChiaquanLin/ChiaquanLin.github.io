---
import { SITE_HERO_IMAGE } from '../consts';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const hasExtra = Astro.slots.has('default');
---

<section
  class="hero"
  id="hero"
  data-extra={hasExtra ? 'true' : 'false'}
  data-image={SITE_HERO_IMAGE ? 'true' : 'false'}
  aria-label="博客简介"
>
  {
    SITE_HERO_IMAGE ? (
      <img class="hero-image" src={SITE_HERO_IMAGE} alt="" />
    ) : (
      <canvas id="hero-canvas" aria-hidden="true"></canvas>
    )
  }
  <div class="hero-frame" aria-hidden="true"></div>
  <div class="hero-fade" aria-hidden="true"></div>
  <div class="hero-layout" id="hero-layout">
    <div class="hero-copy">
      <p class="eyebrow">Personal Blog</p>
      <h1 class="hero-title">{title}</h1>
      <p class="hero-role" aria-label="博客主题">记录 <span id="hero-role">技术</span><span class="role-caret" aria-hidden="true"></span></p>
      <p class="hero-description">{description}</p>
    </div>
    <slot />
  </div>
  <a class="hero-scroll" href="#posts" aria-label="向下浏览"></a>
</section>

<script>
  (() => {
    const canvas = document.getElementById('hero-canvas');
    const hero = document.getElementById('hero');
    const layout = document.getElementById('hero-layout');
    const roleEl = document.getElementById('hero-role');
    if (!canvas || !hero) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const palette = { accent: '#0f7d72', accent2: '#c47a12' };
    let width = 0;
    let height = 0;
    let particles = [];
    let rafId = 0;
    const mouse = { x: -9999, y: -9999 };

    const readPalette = () => {
      const styles = getComputedStyle(document.documentElement);
      palette.accent = styles.getPropertyValue('--accent').trim() || palette.accent;
      palette.accent2 = styles.getPropertyValue('--accent-2').trim() || palette.accent2;
    };

    const toRgba = (hex, alpha) => {
      const cleaned = hex.replace('#', '');
      const full = cleaned.length === 3 ? cleaned.split('').map((c) => c + c).join('') : cleaned;
      const value = parseInt(full, 16);
      const r = (value >> 16) & 255;
      const g = (value >> 8) & 255;
      const b = value & 255;
      return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    };

    const spawn = () => {
      const count = Math.min(110, Math.max(42, Math.floor(width / 12)));
      particles = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.32,
        vy: (Math.random() - 0.5) * 0.32,
        r: Math.random() * 1.7 + 0.8,
        warm: Math.random() > 0.78,
      }));
    };

    const resize = () => {
      const rect = hero.getBoundingClientRect();
      width = Math.max(1, rect.width);
      height = Math.max(1, rect.height);
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      spawn();
      if (reducedMotion) draw();
    };

    const draw = () => {
      ctx.clearRect(0, 0, width, height);
      const linkDist = Math.min(130, width / 8);

      for (const p of particles) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = toRgba(p.warm ? palette.accent2 : palette.accent, 0.55);
        ctx.fill();
      }

      for (let i = 0; i < particles.length; i += 1) {
        const a = particles[i];
        for (let j = i + 1; j < particles.length; j += 1) {
          const b = particles[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const dist = Math.hypot(dx, dy);
          if (dist < linkDist) {
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.strokeStyle = toRgba(palette.accent, (1 - dist / linkDist) * 0.14);
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }
        const dm = Math.hypot(a.x - mouse.x, a.y - mouse.y);
        if (dm < 180) {
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(mouse.x, mouse.y);
          ctx.strokeStyle = toRgba(palette.accent2, (1 - dm / 180) * 0.26);
          ctx.lineWidth = 1;
          ctx.stroke();
        }
      }

      if (!reducedMotion) rafId = requestAnimationFrame(draw);
    };

    const start = () => {
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(draw);
    };

    const handlePointer = (event) => {
      const rect = hero.getBoundingClientRect();
      mouse.x = event.clientX - rect.left;
      mouse.y = event.clientY - rect.top;
      if (layout && !reducedMotion) {
        const cx = (event.clientX / window.innerWidth - 0.5) * 12;
        const cy = (event.clientY / window.innerHeight - 0.5) * 8;
        layout.style.transform = `translate(${cx.toFixed(1)}px, ${cy.toFixed(1)}px)`;
      }
    };

    const clearPointer = () => {
      mouse.x = -9999;
      mouse.y = -9999;
      if (layout) layout.style.transform = '';
    };

    readPalette();
    resize();
    window.addEventListener('resize', resize);
    hero.addEventListener('pointermove', handlePointer, { passive: true });
    hero.addEventListener('pointerleave', clearPointer);
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      window.setTimeout(readPalette, 0);
    });

    const roles = ['技术', '设计', '生活', '写作'];
    if (roleEl && !reducedMotion) {
      let index = 0;
      roleEl.textContent = roles[0];
      window.setInterval(() => {
        roleEl.classList.add('role-swap-out');
        window.setTimeout(() => {
          index = (index + 1) % roles.length;
          roleEl.textContent = roles[index];
          roleEl.classList.remove('role-swap-out');
          roleEl.classList.add('role-swap-in');
          window.setTimeout(() => roleEl.classList.remove('role-swap-in'), 250);
        }, 220);
      }, 2600);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cancelAnimationFrame(rafId);
      } else if (!reducedMotion) {
        start();
      }
    });
  })();
</script>
