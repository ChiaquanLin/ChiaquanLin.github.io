---
// 文章图片/SVG 的查看器：点击放大、滚轮与双指缩放、拖拽平移。
// 标记与样式放在这里；可点击提示样式在 global.css 的 `.post-content img.is-zoomable`。
---

<div
  class="image-lightbox"
  id="image-lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="图片查看器"
  aria-hidden="true"
  hidden
>
  <div class="il-scrim" data-il-action="close" aria-hidden="true"></div>

  <div class="il-stage" data-il-stage>
    <img class="il-image" data-il-image alt="" draggable="false" />
  </div>

  <div class="il-bar" role="group" aria-label="缩放控制">
    <button class="il-btn" type="button" data-il-action="out" aria-label="缩小" title="缩小（-）">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="M8 11h6M20 20l-3.6-3.6" />
      </svg>
    </button>

    <span class="il-level" data-il-level aria-live="polite">100%</span>

    <button class="il-btn" type="button" data-il-action="in" aria-label="放大" title="放大（+）">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="M8 11h6M11 8v6M20 20l-3.6-3.6" />
      </svg>
    </button>

    <button class="il-btn" type="button" data-il-action="reset" aria-label="重置视图" title="重置视图（0）">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3.5 12a8.5 8.5 0 1 0 2.9-6.4" />
        <path d="M3.5 4.5V10h5.5" />
      </svg>
    </button>

    <span class="il-sep" aria-hidden="true"></span>

    <button class="il-btn il-btn-close" type="button" data-il-action="close" aria-label="关闭" title="关闭（Esc）">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6.5 6.5l11 11M17.5 6.5l-11 11" />
      </svg>
    </button>
  </div>

  <p class="il-hints" aria-hidden="true">
    <span class="il-hint il-hint-pointer">滚轮缩放 · 拖拽移动 · 双击放大 · Esc 关闭</span>
    <span class="il-hint il-hint-touch">双指缩放 · 拖拽移动 · 双击放大</span>
  </p>
</div>

<style>
  .image-lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
  }

  .image-lightbox.is-open {
    display: block;
  }

  .il-scrim {
    position: absolute;
    inset: 0;
    background: rgb(2 6 18 / 0.82);
    backdrop-filter: blur(3px);
    cursor: zoom-out;
  }

  .il-stage {
    position: absolute;
    inset: clamp(48px, 7vh, 84px) clamp(10px, 4vw, 64px) clamp(112px, 16vh, 152px);
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: none;
    user-select: none;
    cursor: default;
  }

  .image-lightbox.is-zoomed .il-stage {
    cursor: grab;
  }

  .image-lightbox.is-dragging .il-stage,
  .image-lightbox.is-dragging.is-zoomed .il-stage {
    cursor: grabbing;
  }

  .il-image {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    border-radius: 6px;
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    transform-origin: center center;
    will-change: transform;
    -webkit-user-drag: none;
    user-select: none;
    touch-action: none;
  }

  .il-bar {
    position: absolute;
    left: 50%;
    bottom: clamp(52px, 8vh, 76px);
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.35rem 0.4rem;
    border: 1px solid color-mix(in srgb, var(--border) 65%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    box-shadow: var(--shadow-lg);
    backdrop-filter: blur(10px);
  }

  .il-btn {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .il-btn svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .il-btn:hover {
    background: color-mix(in srgb, var(--accent) 24%, transparent);
  }

  .il-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .il-btn-close:hover {
    background: color-mix(in srgb, var(--accent-2) 26%, transparent);
    color: var(--accent-2);
  }

  .il-level {
    min-width: 3.4rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  .il-sep {
    width: 1px;
    height: 1.35rem;
    margin-inline: 0.2rem;
    background: var(--border);
  }

  .il-hints {
    position: absolute;
    left: 50%;
    bottom: clamp(16px, 2.6vh, 28px);
    transform: translateX(-50%);
    margin: 0;
    font-size: 0.78rem;
    white-space: nowrap;
    color: rgb(255 255 255 / 0.7);
    pointer-events: none;
  }

  .il-hint-touch {
    display: none;
  }

  /* 触控设备上「滚轮 / Esc」没有意义，换成对应的手势说明 */
  @media (pointer: coarse) {
    .il-hint-pointer {
      display: none;
    }

    .il-hint-touch {
      display: inline;
    }
  }

  /* 作用于 <html>，不在组件作用域内，需要 :global 才能生效 */
  :global(html.il-lock) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .image-lightbox.is-open .il-scrim {
      animation: il-fade 200ms ease-out both;
    }

    .image-lightbox.is-open .il-image {
      animation: il-pop 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .image-lightbox.is-open .il-bar,
    .image-lightbox.is-open .il-hints {
      animation: il-rise 240ms ease-out both;
    }
  }

  @keyframes il-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes il-pop {
    from {
      opacity: 0;
      scale: 0.94;
    }
  }

  @keyframes il-rise {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }

  /* 触控设备上放大点击目标到 44px（WCAG 推荐值） */
  @media (pointer: coarse) {
    .il-btn {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  @media (max-width: 760px) {
    .il-hints {
      font-size: 0.72rem;
    }
  }
</style>

<script>
  const MIN_SCALE = 1;
  const MAX_SCALE = 10;
  const STEP = 1.4;
  const WHEEL_SENSITIVITY = 0.0018;
  const DOUBLE_CLICK_SCALE = 2.5;
  const PAN_STEP = 60;

  const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

  /** @type {any} */
  const view = {
    root: null,
    stage: null,
    image: null,
    level: null,
    open: false,
    scale: 1,
    tx: 0,
    ty: 0,
    box: { w: 0, h: 0 },
    area: { w: 0, h: 0 },
    lastFocus: null,
  };

  const pointers = new Map();
  /** @type {any} */
  let pinch = null;

  const query = () => {
    view.root = document.getElementById('image-lightbox');
    view.stage = view.root?.querySelector('[data-il-stage]') ?? null;
    view.image = view.root?.querySelector('[data-il-image]') ?? null;
    view.level = view.root?.querySelector('[data-il-level]') ?? null;
  };

  const measure = () => {
    const { image, stage } = view;
    if (!image || !stage) return;
    view.box = { w: image.offsetWidth, h: image.offsetHeight };
    view.area = { w: stage.clientWidth, h: stage.clientHeight };
  };

  const apply = () => {
    const { image, level, root, scale, tx, ty } = view;
    if (!image) return;
    image.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`;
    if (level) level.textContent = `${Math.round(scale * 100)}%`;
    root?.classList.toggle('is-zoomed', scale > 1.001);
  };

  // 保证图片不会被拖出可视区：放大不足以填满时该轴锁定在中心。
  const clampPan = () => {
    const { box, area, scale } = view;
    const maxX = Math.max(0, (box.w * scale - area.w) / 2);
    const maxY = Math.max(0, (box.h * scale - area.h) / 2);
    view.tx = clamp(view.tx, -maxX, maxX);
    view.ty = clamp(view.ty, -maxY, maxY);
  };

  const resetView = () => {
    view.scale = MIN_SCALE;
    view.tx = 0;
    view.ty = 0;
    apply();
  };

  /**
   * 以某个屏幕点为锚点缩放：该点在缩放前后停留在同一位置。
   * @param {{scale: number, tx: number, ty: number}} base 缩放前的状态
   * @param {number} nextScale 目标缩放倍数
   * @param {{x: number, y: number}} anchorStart 缩放前的锚点（视口坐标）
   * @param {{x: number, y: number}} anchorNow 缩放后的锚点（视口坐标）
   */
  const zoomFrom = (base, nextScale, anchorStart, anchorNow) => {
    const { stage } = view;
    if (!stage) return;
    const rect = stage.getBoundingClientRect();
    const centerX = rect.left + rect.width / 2;
    const centerY = rect.top + rect.height / 2;
    const scale = clamp(nextScale, MIN_SCALE, MAX_SCALE);
    const ratio = scale / base.scale;

    view.scale = scale;
    view.tx = anchorNow.x - centerX - ratio * (anchorStart.x - centerX - base.tx);
    view.ty = anchorNow.y - centerY - ratio * (anchorStart.y - centerY - base.ty);

    clampPan();
    apply();
  };

  const zoomCenter = (factor) => {
    const { stage, scale, tx, ty } = view;
    if (!stage) return;
    const rect = stage.getBoundingClientRect();
    const anchor = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
    zoomFrom({ scale, tx, ty }, scale * factor, anchor, anchor);
  };

  const openFrom = (source) => {
    query();
    const { root, image, stage } = view;
    if (!root || !image || !stage || view.open) return;

    view.lastFocus = document.activeElement;

    // 正文里显示的是压缩版，data-full-src 指向原图。
    // 先秒开已缓存的压缩版，再在后台把原图换上来，避免等待大图时白屏。
    const displaySrc = source.currentSrc || source.src;
    const fullSrc = source.dataset.fullSrc || '';
    view.token = (view.token ?? 0) + 1;
    const token = view.token;

    image.src = displaySrc;
    image.alt = source.alt || '';
    for (const attribute of ['width', 'height']) {
      if (source.hasAttribute(attribute)) image.setAttribute(attribute, source.getAttribute(attribute));
      else image.removeAttribute(attribute);
    }

    if (fullSrc && fullSrc !== displaySrc) {
      const full = new Image();
      full.decoding = 'async';
      full.addEventListener('load', () => {
        // 期间用户可能已经关掉或换了一张图
        if (!view.open || view.token !== token) return;
        view.image.src = fullSrc;
        onImageLoad();
      });
      full.src = fullSrc;
      view.pendingFull = full;
    } else {
      view.pendingFull = null;
    }

    root.hidden = false;
    root.classList.add('is-open');
    root.setAttribute('aria-hidden', 'false');
    // 只在打开期间监听滚轮，避免全局非 passive 监听影响页面滚动
    root.addEventListener('wheel', onWheel, { passive: false });
    document.documentElement.classList.add('il-lock');

    view.open = true;
    measure();
    resetView();

    // 图片尺寸可能在解码完成后才确定，重新测量一次
    image.addEventListener('load', onImageLoad, { once: true });

    // 延后一帧再取焦点：部分浏览器会在 click 之后才处理“按下即聚焦”，
    // 立即 focus 会被图片抢回。注意要限定在工具栏内，遮罩层同样带 data-il-action="close"。
    const closeButton = root.querySelector('.il-bar [data-il-action="close"]');
    requestAnimationFrame(() => {
      if (view.open && closeButton instanceof HTMLElement) closeButton.focus();
    });
  };

  const close = () => {
    if (!view.open) return;
    view.open = false;
    pointers.clear();
    pinch = null;

    const { root } = view;
    if (root) {
      root.removeEventListener('wheel', onWheel);
      root.classList.remove('is-open', 'is-dragging', 'is-zoomed');
      root.setAttribute('aria-hidden', 'true');
      root.hidden = true;
    }

    document.documentElement.classList.remove('il-lock');

    const previous = view.lastFocus;
    view.lastFocus = null;
    if (previous instanceof HTMLElement && document.contains(previous)) previous.focus();
  };

  const onImageLoad = () => {
    if (!view.open) return;
    measure();
    clampPan();
    apply();
  };

  const onClick = (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const actionEl = target.closest('[data-il-action]');
    if (actionEl) {
      const action = actionEl.getAttribute('data-il-action');
      if (action === 'close') close();
      else if (action === 'in') zoomCenter(STEP);
      else if (action === 'out') zoomCenter(1 / STEP);
      else if (action === 'reset') resetView();
      return;
    }

    if (view.open) return;

    const image = target.closest('.post-content img.is-zoomable');
    if (image instanceof HTMLImageElement) {
      event.preventDefault();
      openFrom(image);
    }
  };

  const onPointerDown = (event) => {
    if (!view.open) return;
    const target = event.target;
    if (!(target instanceof Element) || !target.closest('[data-il-stage]')) return;
    if (event.pointerType === 'mouse' && event.button !== 0) return;

    event.preventDefault();
    view.stage?.setPointerCapture(event.pointerId);
    pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });

    if (pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      pinch = {
        scale: view.scale,
        tx: view.tx,
        ty: view.ty,
        dist: Math.hypot(a.x - b.x, a.y - b.y),
        cx: (a.x + b.x) / 2,
        cy: (a.y + b.y) / 2,
      };
      view.root?.classList.remove('is-dragging');
    } else if (pointers.size === 1 && view.scale > 1.001) {
      view.root?.classList.add('is-dragging');
    }
  };

  const onPointerMove = (event) => {
    const previous = pointers.get(event.pointerId);
    if (!previous || !view.open) return;

    const next = { x: event.clientX, y: event.clientY };
    pointers.set(event.pointerId, next);

    if (pointers.size === 2 && pinch) {
      const [a, b] = [...pointers.values()];
      const distance = Math.hypot(a.x - b.x, a.y - b.y);
      if (pinch.dist > 0 && distance > 0) {
        zoomFrom(
          pinch,
          pinch.scale * (distance / pinch.dist),
          { x: pinch.cx, y: pinch.cy },
          { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 },
        );
      }
      return;
    }

    if (pointers.size !== 1) return;

    view.tx += next.x - previous.x;
    view.ty += next.y - previous.y;
    clampPan();
    apply();
  };

  const onPointerUp = (event) => {
    if (!pointers.has(event.pointerId)) return;
    pointers.delete(event.pointerId);
    view.stage?.releasePointerCapture?.(event.pointerId);

    if (pointers.size < 2) pinch = null;
    if (pointers.size === 0) view.root?.classList.remove('is-dragging');
  };

  const onWheel = (event) => {
    if (!view.open) return;
    const target = event.target;
    if (!(target instanceof Element) || !target.closest('[data-il-stage]')) return;

    event.preventDefault();
    const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? 100 : 1;
    const factor = Math.exp(-event.deltaY * unit * WHEEL_SENSITIVITY);
    const anchor = { x: event.clientX, y: event.clientY };
    zoomFrom({ scale: view.scale, tx: view.tx, ty: view.ty }, view.scale * factor, anchor, anchor);
  };

  const onDoubleClick = (event) => {
    if (!view.open) return;
    const target = event.target;
    if (!(target instanceof Element) || !target.closest('[data-il-stage]')) return;

    if (view.scale > 1.001) {
      resetView();
      return;
    }

    const anchor = { x: event.clientX, y: event.clientY };
    zoomFrom({ scale: MIN_SCALE, tx: 0, ty: 0 }, DOUBLE_CLICK_SCALE, anchor, anchor);
  };

  const pan = (dx, dy) => {
    view.tx += dx;
    view.ty += dy;
    clampPan();
    apply();
  };

  const onKeyDown = (event) => {
    if (!view.open) return;

    const { root, scale } = view;

    if (event.key === 'Escape') {
      event.preventDefault();
      close();
      return;
    }

    if (event.key === 'Tab' && root) {
      const focusable = [...root.querySelectorAll('button:not([disabled])')];
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement;
      if (event.shiftKey && (active === first || !root.contains(active))) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && (active === last || !root.contains(active))) {
        event.preventDefault();
        first.focus();
      }
      return;
    }

    if (event.key === '+' || event.key === '=') {
      event.preventDefault();
      zoomCenter(STEP);
      return;
    }

    if (event.key === '-' || event.key === '_') {
      event.preventDefault();
      zoomCenter(1 / STEP);
      return;
    }

    if (event.key === '0') {
      event.preventDefault();
      resetView();
      return;
    }

    if (scale > 1.001 && event.key.startsWith('Arrow')) {
      event.preventDefault();
      if (event.key === 'ArrowLeft') pan(PAN_STEP, 0);
      else if (event.key === 'ArrowRight') pan(-PAN_STEP, 0);
      else if (event.key === 'ArrowUp') pan(0, PAN_STEP);
      else if (event.key === 'ArrowDown') pan(0, -PAN_STEP);
    }
  };

  const onResize = () => {
    if (!view.open) return;
    measure();
    clampPan();
    apply();
  };

  document.addEventListener('astro:before-swap', () => {
    if (view.open) close();
  });

  const decorate = () => {
    for (const node of document.querySelectorAll('.post-content img')) {
      if (!(node instanceof HTMLImageElement)) continue;
      if (node.dataset.zoomReady === '1') continue;
      // 包在链接里的图片、或显式声明不缩放的图片交给原有行为
      if (node.closest('a') || node.hasAttribute('data-no-zoom')) continue;

      node.dataset.zoomReady = '1';
      node.classList.add('is-zoomable');
      node.setAttribute('tabindex', '0');
      node.setAttribute('role', 'button');
      const label = node.getAttribute('alt')?.trim();
      node.setAttribute('aria-label', label ? `放大查看：${label}` : '放大查看图片');

      node.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ' || event.key === 'Spacebar') {
          event.preventDefault();
          openFrom(node);
        }
      });
    }
  };

  const start = () => {
    query();
    if (view.open) close();
    decorate();
  };

  if (!window.__dshLightboxBound) {
    window.__dshLightboxBound = true;
    document.addEventListener('click', onClick);
    document.addEventListener('keydown', onKeyDown);
    document.addEventListener('pointerdown', onPointerDown);
    document.addEventListener('pointermove', onPointerMove);
    document.addEventListener('pointerup', onPointerUp);
    document.addEventListener('pointercancel', onPointerUp);
    document.addEventListener('dblclick', onDoubleClick);
    window.addEventListener('resize', onResize);
    document.addEventListener('astro:page-load', start);
  }

  start();
</script>
