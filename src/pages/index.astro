---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import ResumeCard from '../components/ResumeCard.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts, getTags, getCategories } from '../lib/posts';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = await getPublishedPosts();
const tags = await getTags();
const categories = await getCategories();
const [featured, ...latest] = posts;
---

<BaseLayout>
  <HeroCanvas title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <ResumeCard />
  </HeroCanvas>

  <div class="home-sections">
    <section class="section" id="posts" data-reveal>
      <div class="section-heading">
        <h2 class="section-title">精选文章</h2>
        <a href="/blog">查看全部</a>
      </div>
      {featured && <FeaturedPost post={featured} />}
    </section>

    {
      latest.length > 0 && (
        <section class="section" data-reveal>
          <div class="section-heading">
            <h2 class="section-title">最新文章</h2>
            <a href="/blog">查看全部</a>
          </div>
          <div class="post-grid">
            {latest.map((post) => <PostCard post={post} />)}
          </div>
        </section>
      )
    }

    <section class="section" data-reveal>
      <div class="section-heading">
        <h2 class="section-title">主题</h2>
        <a href="/tags">标签 · 分类</a>
      </div>
      <div class="home-topics">
        <div>
          <p class="resume-section-title">标签</p>
          <div class="tag-cloud">
            {
              tags.map((tag) => (
                <a class="tag-chip tag-link" href={`/tags/${encodeURIComponent(tag.name)}`}>
                  #{tag.name}
                </a>
              ))
            }
          </div>
        </div>
        <div>
          <p class="resume-section-title">分类</p>
          <div class="taxonomy-grid">
            {
              categories.map((category) => (
                <a class="taxonomy-card" href={`/categories/${encodeURIComponent(category.name)}`}>
                  <span>{category.name}</span>
                  <span class="taxonomy-count">{category.count}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
